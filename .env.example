# ========================================
# Auto-Memories-Doll 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# ========================================

# 开发运行环境；使用 npm run build / npm start 时改为 production 或移除此项
NODE_ENV=development

# 以下模型变量为历史配置示例，当前模型调用读取 /settings/ai 保存的 SQLite 配置。
# 它们不会自动导入或覆盖设置页；请在设置页填写端点、凭证和模型后保存。
# 模型 API 中转站地址示例（兼容 OpenAI 格式的 API）
# 示例: https://api.openai.com/v1
MODEL_BASE_URL=http://localhost:8080

# API 密钥示例（设置页未配置凭证时，整理回退为原文保存，搜索使用关键词）
MODEL_API_KEY=

# ── 三模型配置示例（请在设置页配置，以下变量不会导入 SQLite） ──
# 旗舰模型 — 知识卡片整理（默认 gpt-4o）
FLAGSHIP_MODEL=gpt-4o
# 普通模型 — 话题分类、主题资料辅助整理（默认 gpt-4o-mini）
STANDARD_MODEL=gpt-4o-mini
# 廉价模型 — 检索查询改写（默认 gpt-4o-mini）
BUDGET_MODEL=gpt-4o-mini
# Embedding 模型 — 向量化（默认 text-embedding-3-small）
EMBEDDING_MODEL=text-embedding-3-small

# 向量后端：hnsw（默认，可用时）或 js（精确余弦降级/CI）
VECTOR_BACKEND=hnsw

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 记忆数据存储根目录（相对于项目根目录）
# 注意：数据库始终留在此目录，笔记路径可在设置面板中改为其他位置（如 D 盘）
MEMORY_ROOT=./memory-root

# 服务端口
PORT=3000
