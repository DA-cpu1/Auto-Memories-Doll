# ========================================
# Auto-Memories-Doll 环境变量配置
# 复制此文件为 .env.local 并填入实际值
# ========================================

# 运行环境: development | production
NODE_ENV=development

# 模型 API 中转站地址（兼容 OpenAI 格式的 API 均可）
# 示例: https://api.openai.com/v1
MODEL_BASE_URL=http://localhost:8080

# API 密钥（可选；留空时 LLM/Embedding 降级，候选转人工审核且搜索使用关键词）
MODEL_API_KEY=

# ── 三模型分层配置（可选，未设置时使用 AiConfig UI 中保存的值） ──
# 旗舰模型 — 分流、分析、评估（默认 gpt-4o）
FLAGSHIP_MODEL=gpt-4o
# 普通模型 — 知识整理、结构化生成（默认 gpt-4o-mini）
STANDARD_MODEL=gpt-4o-mini
# 廉价模型 — 测试生成、摘要、简单提取（默认 gpt-4o-mini）
BUDGET_MODEL=gpt-4o-mini
# Embedding 模型 — 向量化（默认 text-embedding-3-small）
EMBEDDING_MODEL=text-embedding-3-small

# 向量后端：hnsw（默认，可用时）或 js（精确余弦降级/CI）
VECTOR_BACKEND=hnsw

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 记忆数据存储根目录（相对于项目根目录）
# 注意：数据库始终留在此目录，笔记路径可在设置面板中改为其他位置（如 D 盘）
MEMORY_ROOT=./memory-root

# 服务端口
PORT=3000
